### `start-all.ps1`

```powershell
param(
    [switch]$IncludeTosRiskBridges
)

$ErrorActionPreference = "Stop"

if (-not (Get-Command docker -ErrorAction SilentlyContinue)) {
    throw "Docker wurde nicht gefunden. Docker Desktop installieren und starten."
}

& docker info *> $null
if ($LASTEXITCODE -ne 0) {
    throw "Docker Desktop läuft nicht. Bitte starten und erneut versuchen."
}

$composeArgs = @("compose")
if ($IncludeTosRiskBridges) {
    Write-Warning "ToS-Risiko-Bridges werden gestartet. Nur mit eigenen Accounts und nach eigener ToS-Prüfung verwenden."
    $composeArgs += @("--profile", "tos-risk")
}
$composeArgs += @("up", "-d")

& docker @composeArgs
if ($LASTEXITCODE -ne 0) {
    throw "docker compose up ist fehlgeschlagen."
}

Write-Host "Warte auf LiteLLM-Router ..."
$ready = $false
for ($i = 0; $i -lt 30; $i++) {
    try {
        $resp = Invoke-WebRequest -Uri "http://127.0.0.1:4000/health/liveliness" -TimeoutSec 2 -UseBasicParsing
        if ($resp.StatusCode -ge 200 -and $resp.StatusCode -lt 300) {
            $ready = $true
            break
        }
    } catch {
        Start-Sleep -Seconds 1
    }
}

if (-not $ready) {
    Write-Warning "LiteLLM ist noch nicht bereit. Logs prüfen: docker compose logs litellm"
}

Write-Host ""
Write-Host "Zentrale Endpunkte:"
Write-Host "  LiteLLM API:      http://127.0.0.1:4000/v1"
Write-Host "  LiteLLM Health:   http://127.0.0.1:4000/health/liveliness"
Write-Host ""
Write-Host "Bridge-Dashboards (nur falls -IncludeTosRiskBridges gesetzt):"
Write-Host "  QwenGate:         http://127.0.0.1:8088"
Write-Host "  composer-api:     http://127.0.0.1:8090"
Write-Host "  codex-api:        http://127.0.0.1:8091"
Write-Host "  WebModel:         http://127.0.0.1:8092"
Write-Host "  WebAI-to-API:     http://127.0.0.1:8093"
Write-Host ""
Write-Host "Stop: .\stop-all.ps1"
```

