### `tools/parse_and_classify.py`

```python
from __future__ import annotations
import json, re
from pathlib import Path

SRC = Path.home() / "Downloads" / "ai_provider(2).txt"
OUT = Path(__file__).resolve().parent.parent / "classification.json"

RISKY_CATS = {"webclient_automation", "web_cookie_bypass", "reverse_engineered_web"}

def parse_blocks(text: str):
    parts = re.split(r"(?m)^##\s+", text)
    for part in parts[1:]:
        lines = part.splitlines()
        name = lines[0].strip()
        body = "\n".join(lines[1:])
        def field(key):
            m = re.search(rf"\*\*{re.escape(key)}:\*\*\s*([^|\n]+)", body, re.I)
            return m.group(1).strip() if m else ""
        cats = [c.strip() for c in field("kategorien").split(",") if c.strip()]
        flags = field("flags")
        riskant = bool(re.search(r"riskant\s*=\s*True", flags, re.I))
        empf = "unklar" if re.search(r"empfehlenswert\s*=\s*unklar", flags, re.I) else bool(re.search(r"empfehlenswert\s*=\s*True", flags, re.I))
        yield {
            "name": name,
            "id": field("id"),
            "url": field("url"),
            "kategorien": cats,
            "verbindungsart": field("verbindungsart"),
            "auth_typ": field("auth_typ") or None,
            "free_tier_typ": field("free_tier_typ") or None,
            "riskant": riskant,
            "empfehlenswert": empf,
            "flags_raw": flags,
        }

def classify(p):
    cats = set(p["kategorien"])
    flags = p["flags_raw"].lower()
    if "anonym_pseudo_key" in cats and ("illegal" in flags or "nicht_erlaubt" in flags):
        return "SCHWARZ"
    if (p["riskant"] and (cats & RISKY_CATS)) or "illegal" in flags:
        return "ROT"
    if p["riskant"] or p["empfehlenswert"] == "unklar":
        return "GELB"
    return "GRÜN"

def main():
    text = SRC.read_text(encoding="utf-8")
    out = []
    for p in parse_blocks(text):
        out.append({
            "id": p["id"],
            "name": p["name"],
            "security_class": classify(p),
            "riskant": p["riskant"],
            "empfehlenswert": p["empfehlenswert"],
            "verbindungsart": p["verbindungsart"],
            "auth_typ": p["auth_typ"],
            "free_tier_typ": p["free_tier_typ"],
            "url": p["url"],
            "note": "automatisch klassifiziert",
        })
    OUT.write_text(json.dumps(out, ensure_ascii=False, indent=2), encoding="utf-8")
    print(f"{len(out)} Provider geschrieben: {OUT}")

if __name__ == "__main__":
    main()
```

