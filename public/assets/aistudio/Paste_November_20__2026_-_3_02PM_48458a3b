### `tools/run_tests.py`

```python
from __future__ import annotations
import csv, json, os, re
from pathlib import Path
import requests

ROOT = Path(__file__).resolve().parent.parent
CLASSIFICATION = ROOT / "classification.json"
OUT = ROOT / "test_results.csv"
TIMEOUT = 10

ENV_MAP = {
    "openrouter": "OPENROUTER_API_KEY",
    "requesty": "REQUESTY_API_KEY",
    "sambanova-cloud": "SAMBANOVA_API_KEY",
    "siliconflow": "SILICONFLOW_API_KEY",
    "zai-glm-api": "ZAI_API_KEY",
    "vercel-ai-gateway": "VERCEL_AI_GATEWAY_API_KEY",
    "zenmux": "ZENMUX_API_KEY",
    "xai-grok-api": "XAI_API_KEY",
    "openai-api": "OPENAI_API_KEY",
    "together-ai": "TOGETHER_API_KEY",
    "runpod": "RUNPOD_API_KEY",
    "replicate": "REPLICATE_API_TOKEN",
    "oracle-oci-genai": "OCI_GENAI_API_KEY",
    "ollama-cloud": "OLLAMA_API_KEY",
}

def reachability(url: str):
    try:
        r = requests.head(url, timeout=TIMEOUT, allow_redirects=True)
        if r.status_code in (405, 403, 400):
            r = requests.get(url, timeout=TIMEOUT, allow_redirects=True)
        return r.status_code, ""
    except Exception as e:
        return "", str(e)[:180]

def main():
    providers = json.loads(CLASSIFICATION.read_text(encoding="utf-8"))
    rows = []
    for p in providers:
        cls = p["security_class"]
        url = p.get("url") or ""
        status, code, note = "PENDING", "", ""
        if cls == "SCHWARZ":
            status, note = "SKIPPED (illegal)", "nur dokumentiert"
        elif cls == "ROT":
            status, note = "SKIPPED (ToS-Risiko)", "nicht getestet"
        elif cls == "GELB":
            if url:
                code, err = reachability(url)
                status = "REACHABILITY_OK" if code and int(code) < 500 else "REACHABILITY_FAIL"
                note = "nur Reachability" + (f"; {err}" if err else "")
            else:
                status, note = "SKIPPED (keine URL)", ""
        else:
            auth = (p.get("auth_typ") or "").lower()
            if auth == "api_key":
                env = ENV_MAP.get(p["id"], p["id"].upper().replace("-", "_") + "_API_KEY")
                if not os.environ.get(env):
                    status, note = "SKIPPED (kein Key)", f"Env {env} nicht gesetzt"
                else:
                    code, err = reachability(url)
                    status, note = "REACHABILITY_OK", "Key vorhanden; API-Call manuell prüfen"
            elif url:
                code, err = reachability(url)
                status = "REACHABILITY_OK" if code and int(code) < 500 else "REACHABILITY_FAIL"
                note = err
            else:
                status, note = "SKIPPED (keine URL)", ""
        rows.append({
            "id": p["id"], "name": p["name"], "kategorie": cls,
            "status": status, "http_code": code,
            "risky": p["riskant"], "empfohlen": p["empfehlenswert"],
            "note": note, "url": url,
        })
    with OUT.open("w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=["id","name","kategorie","status","http_code","risky","empfohlen","note","url"])
        w.writeheader()
        w.writerows(rows)
    print(f"{len(rows)} Zeilen geschrieben: {OUT}")

if __name__ == "__main__":
    main()
```

